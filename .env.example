# Copy to .env and fill in server-side credentials. Never use VITE_ for secrets.
# Use http://127.0.0.1:5173 locally and https://partyclubapp.com in production.
SITE_URL=http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Plain email address authorized by the sending provider (no display name).
SMTP_FROM=
